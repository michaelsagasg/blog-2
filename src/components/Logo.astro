---
import { site } from '../lib/site';
const [first, ...rest] = site.name.match(/[A-Z][a-z0-9]*|[a-z0-9]+/g) ?? [site.name];
---
<span class="logo">
  <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect class="lm-step" x="3" y="24" width="6" height="5" />
    <rect class="lm-step" x="11" y="18" width="6" height="11" />
    <rect class="lm-step" x="19" y="11" width="6" height="18" />
    <rect class="lm-step lm-step-top" x="27" y="4" width="2" height="25" />
    <circle class="lm-dot" cx="6" cy="22" r="1.6" />
    <circle class="lm-dot" cx="14" cy="16" r="1.6" />
    <circle class="lm-dot" cx="22" cy="9" r="1.6" />
  </svg>
  <span class="brand-name"><em>{first}</em>{rest.join('')}</span>
</span>
