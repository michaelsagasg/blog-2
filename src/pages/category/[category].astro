---
import Base from '../../layouts/Base.astro';
import IndexTable from '../../components/IndexTable.astro';
import { getPosts, catLabel, catBlurb, catTone, catSymbol } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const cats = [...new Set(posts.map((p) => p.data.category))];
  return cats.map((category) => ({ params: { category }, props: { posts: posts.filter((p) => p.data.category === category) } }));
}
const { category } = Astro.params;
const { posts } = Astro.props;
---
<Base title={catLabel(category)} description={catBlurb(category)}>
  <div class="wrap">
    <section class={`page-head t-${catTone(category)}`}>
      <p class="idx-tag"><b>{catSymbol(category)}</b>{posts.length} guides</p>
      <h1>{catLabel(category)}</h1>
      <p>{catBlurb(category)}</p>
    </section>
    <IndexTable posts={posts} showCat={false} />
  </div>
</Base>
