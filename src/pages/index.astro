---
import Base from '../layouts/Base.astro';
import HeroArt from '../components/HeroArt.astro';
import IndexTable from '../components/IndexTable.astro';
import { site, getPosts, countBy, catLabel, catTone, catSymbol, fmtDate, withBase, bannerHref, orgJsonLd } from '../lib/site';
const posts = await getPosts();
const cats = countBy(posts, (p) => p.data.category);
const [lead] = posts;
const b = site.banner;
---
<Base title={site.name} description={site.tagline || undefined} jsonLd={orgJsonLd(Astro.site!)}>
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-copy">
        {lead && <p class="dateline">Updated {fmtDate(lead.data.date)}</p>}
        <h1>Retatrutide and tirzepatide titration schedules, week by week</h1>
        <p class="hero-sub">Every dose step, how long to hold it, and what to check before you move up, built for UK readers starting a GLP-1 peptide.</p>
        <div class="hero-cta">
          {b.enabled && <a class="btn-shop" href={bannerHref(b.url)} rel="sponsored noopener">{b.button} <span aria-hidden="true">→</span></a>}
          <a class="text-link" href="#all">Browse the schedules <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="spec-box">
        <p class="spec-label">Fig. 1 — weekly dose ladder</p>
        <HeroArt />
      </div>
    </div>
  </section>

  <section class="wrap topics" aria-labelledby="topics">
    <h2 id="topics" class="sec-title">The ladder, by topic</h2>
    <div class="topic-strip" role="list">
      {cats.map(([c, n]) => (
        <a role="listitem" class={`topic-seg t-${catTone(c)}`} href={withBase(`/category/${c}/`)}>
          <span class="idx-tag"><b>{catSymbol(c)}</b></span>
          <span class="topic-name">{catLabel(c)}</span>
          <span class="topic-count">{n} guides</span>
        </a>
      ))}
    </div>
  </section>

  {b.enabled && (
    <section class="wrap shop-callout" aria-label="Shop">
      <div class="shop-callout-in">
        <p>{b.headline}</p>
        <a class="btn-line" href={bannerHref(b.url)} rel="sponsored noopener">{b.button} <span aria-hidden="true">→</span></a>
      </div>
    </section>
  )}

  <section class="wrap library" aria-labelledby="all">
    <div class="lib-head">
      <h2 id="all" class="sec-title">All schedules and guides</h2>
      <form class="search" role="search" onsubmit="return false">
        <input type="search" data-search placeholder="Search, for example week 4 or bac water" aria-label="Search articles" autocomplete="off" />
      </form>
    </div>
    <ul class="filters" aria-label="Filter by topic">
      <li><button type="button" data-chip="all" aria-pressed="true">All <span>{posts.length}</span></button></li>
      {cats.map(([cat, n]) => <li><button class={`t-${catTone(cat)}`} type="button" data-chip={cat} aria-pressed="false"><b>{catSymbol(cat)}</b>{catLabel(cat)} <span>{n}</span></button></li>)}
    </ul>
    <IndexTable posts={posts} filterable />
    <p class="empty" data-empty hidden>No articles match that search. Try a different word.</p>
  </section>
</Base>
